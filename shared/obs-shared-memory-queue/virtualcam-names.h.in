#pragma once

/* Shared identifiers for the virtual camera. Configurable per build via the
 * VIRTUALCAM_QUEUE_NAME / VIRTUALCAM_CONFIG_FILE CMake variables; every
 * consumer (writer plugin, DirectShow filter) and both architectures must
 * agree on the same values, so they live in a single generated header. */

#define VIRTUALCAM_QUEUE_NAME_W L"@VIRTUALCAM_QUEUE_NAME@"
#define VIRTUALCAM_CONFIG_FILE_A "@VIRTUALCAM_CONFIG_FILE@"
#define VIRTUALCAM_CONFIG_FILE_W L"@VIRTUALCAM_CONFIG_FILE@"
