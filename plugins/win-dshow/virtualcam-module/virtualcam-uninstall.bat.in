@echo off
@cd /d "%~dp0"
goto checkAdmin

:checkAdmin
	net session >nul 2>&1
	if %errorLevel% == 0 (
		echo.
	) else (
		echo Administrative rights are required, please re-run this script as Administrator.
		goto end
	)

:uninstallDLLs
	if exist "%~dp0\core\win-dshow\data\lvc920x86.dll" (
		regsvr32.exe /u /s "%~dp0\core\win-dshow\data\lvc920x86.dll"
	) else (
		regsvr32.exe /u /s lvc920x86.dll
	)
	if exist "%~dp0\core\win-dshow\data\lvc920x64.dll" (
		regsvr32.exe /u /s "%~dp0\core\win-dshow\data\lvc920x64.dll"
	) else (
		regsvr32.exe /u /s lvc920x64.dll
	)

:endSuccess
	echo Virtual Cam uninstalled!
	echo.

:end
	pause
	exit
